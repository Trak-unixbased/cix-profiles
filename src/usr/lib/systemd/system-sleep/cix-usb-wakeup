#!/bin/sh
# $1: pre|post, $2: suspend|hibernate|hybrid-sleep|suspend-then-hibernate
#
# cdns-usbssp: CIX vendor kernel driver
# cdns-usb3:   mainline Cadence USB3/USBSSP platform driver

set_wakeup() {
    for f in \
        /sys/bus/platform/drivers/cdns-usbssp/*/power/wakeup \
        /sys/bus/platform/drivers/cdns-usb3/*/power/wakeup
    do
        [ -w "$f" ] || continue
        echo "$1" > "$f" || true
    done
}

case $1 in
  pre)
    set_wakeup enabled
    ;;
  post)
    set_wakeup disabled
    ;;
esac

exit 0
