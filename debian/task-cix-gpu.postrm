#!/bin/sh
set -e

#DEBHELPER#

case $1 in
    remove|abort-install)
        conflicts="/opt/cixgpu-compat/app.json"
        for i in $conflicts
        do
            if [ "$(dpkg-divert --listpackage "$i")" = "task-cix-gpu" ]; then
                # The file at the original path was generated by our postinst.
                # dpkg-divert refuses to rename the vendor file back over it,
                # so drop it first.
                rm -f "$i" "$i.tmp" "$i.new"
                dpkg-divert --package task-cix-gpu --rename --remove "$i"
            fi
        done
        ;;
esac

exit 0
